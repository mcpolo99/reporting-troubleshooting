<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporting &amp; Troubleshooting toolset" Height="720" Width="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBgColor}" FontFamily="Segoe UI">
  <!--
    SHELL ONLY. Each tab's body is a reusable control loaded from Schemas\Tabs\<Name>Tab.xaml and injected
    into the matching TabItem at runtime (GUI\Show-MainWindow.ps1). Keep this file to the window chrome, the
    tab headers, the shared Output pane and the bottom status bar - put tab content in its own Tabs\ file.
  -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="150"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TabControl x:Name="Tabs" Grid.Row="0" Background="{DynamicResource CardBgColor}">
      <TabItem x:Name="TabPackages" Header="Packages"/>
      <TabItem x:Name="TabPerfView" Header="PerfView"/>
      <TabItem x:Name="TabMonitor"  Header="ProcDump Monitor"/>
      <TabItem x:Name="TabCase"     Header="ProcDump Case"/>
    </TabControl>

    <TextBlock Grid.Row="1" Text="Output" Foreground="{DynamicResource AppIdColor}" Margin="2,10,0,4"/>
    <TextBox x:Name="TxtOutput" Grid.Row="2" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
             TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
             Background="{DynamicResource CardBgColor}" Foreground="{DynamicResource AppFgColor}"/>

    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock x:Name="LblVersion" DockPanel.Dock="Right" Foreground="{DynamicResource AppIdColor}" VerticalAlignment="Center" Margin="8,0,0,0"/>
      <Button x:Name="BtnShortcut" DockPanel.Dock="Right" Content="Install desktop shortcut" Height="24" Padding="8,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="LblBusy" Text="Ready" Foreground="{DynamicResource AppIdColor}" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
