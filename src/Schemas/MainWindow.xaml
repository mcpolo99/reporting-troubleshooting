<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporting &amp; Troubleshooting toolset" SizeToContent="Height"
        Width="520" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource AppBgColor}" FontFamily="Segoe UI">
  <Border Padding="20">
    <StackPanel>
      <TextBlock Text="Reporting &amp; Troubleshooting toolset" Foreground="{DynamicResource AppFgColor}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Capture crash, hang and performance evidence for dump analysis. Each tool opens in its own window."
                 Foreground="{DynamicResource AppIdColor}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,16"/>

      <Button x:Name="BtnPerfView" Style="{DynamicResource ToolCardButtonStyle}">
        <StackPanel>
          <TextBlock Text="PerfView performance tracing" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppFgColor}"/>
          <TextBlock Text="Install PerfView; start/stop ETL traces with size-capped profiles" FontSize="11" Foreground="{DynamicResource AppIdColor}"/>
        </StackPanel>
      </Button>

      <Button x:Name="BtnMonitor" Style="{DynamicResource ToolCardButtonStyle}">
        <StackPanel>
          <TextBlock Text="ProcDump monitor (background)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppFgColor}"/>
          <TextBlock Text="Self-installing scheduled task; auto-captures crash/hang dumps" FontSize="11" Foreground="{DynamicResource AppIdColor}"/>
        </StackPanel>
      </Button>

      <Button x:Name="BtnCase" Style="{DynamicResource ToolCardButtonStyle}">
        <StackPanel>
          <TextBlock Text="One-shot process dump capture" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppFgColor}"/>
          <TextBlock Text="Temporary capture + evidence zip (nothing installed)" FontSize="11" Foreground="{DynamicResource AppIdColor}"/>
        </StackPanel>
      </Button>

      <DockPanel Margin="0,8,0,0">
        <TextBlock x:Name="LblVersion" DockPanel.Dock="Left" Foreground="{DynamicResource AppIdColor}" FontSize="11" VerticalAlignment="Center"/>
        <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Close" Style="{DynamicResource SecondaryButtonStyle}"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
