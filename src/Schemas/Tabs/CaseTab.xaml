<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="14">
    <TextBlock Text="One-shot capture: run an app under ProcDump, collect dumps + evidence (no install)." Foreground="{DynamicResource AppIdColor}" Margin="0,0,0,10"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Exe:" Foreground="{DynamicResource AppFgColor}" VerticalAlignment="Center" Width="40"/>
      <TextBox x:Name="TxtCaseExe" Width="430" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Button x:Name="BtnCaseBrowse" Content="Browse..." Height="28" MinWidth="80"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Capture mode:" Foreground="{DynamicResource AppFgColor}" VerticalAlignment="Center" Width="90"/>
      <ComboBox x:Name="CmbCaseMode" Width="220" VerticalAlignment="Center">
        <ComboBoxItem Content="Auto (crash, exit or hang)" IsSelected="True"/>
        <ComboBoxItem Content="Crash only (unhandled)"/>
        <ComboBoxItem Content="Hang only"/>
        <ComboBoxItem Content="Silent exit"/>
      </ComboBox>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <CheckBox x:Name="ChkCaseFusion"    Content="Assembly binding log (.NET)" Foreground="{DynamicResource AppFgColor}" Margin="0,0,16,0"/>
      <CheckBox x:Name="ChkCaseAppConfig" Content="Include .config files"        Foreground="{DynamicResource AppFgColor}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="Timeout (sec):" Foreground="{DynamicResource AppFgColor}" VerticalAlignment="Center" Width="90"/>
      <TextBox x:Name="TxtCaseTimeout" Text="300" Width="70" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Button x:Name="BtnCaseRun" Content="Run capture" Height="30" MinWidth="120"/>
    </StackPanel>
    <TextBlock x:Name="LblCaseStatus" Foreground="{DynamicResource AppIdColor}" TextWrapping="Wrap"/>
  </StackPanel>
</ScrollViewer>
