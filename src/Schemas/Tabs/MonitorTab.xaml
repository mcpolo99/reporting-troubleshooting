<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="14">
    <TextBlock Text="Background monitor (scheduled task) that auto-captures crash/hang dumps." Foreground="{DynamicResource AppIdColor}" Margin="0,0,0,10"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <Button x:Name="BtnMonEnable"  Content="Enable Service"  Height="30" MinWidth="110" Margin="0,0,8,0"/>
      <Button x:Name="BtnMonStart"   Content="Start Monitor"   Height="30" MinWidth="100" Margin="0,0,8,0"/>
      <Button x:Name="BtnMonStop"    Content="Stop Monitor"    Height="30" MinWidth="100" Margin="0,0,8,0"/>
      <Button x:Name="BtnMonStatus"  Content="Status"          Height="30" MinWidth="80"  Margin="0,0,8,0"/>
      <Button x:Name="BtnMonDisable" Content="Disable Service" Height="30" MinWidth="110"/>
    </StackPanel>
    <TextBlock x:Name="LblMonStatus" Foreground="{DynamicResource AppIdColor}" TextWrapping="Wrap" Margin="0,0,0,12"/>

    <Border BorderBrush="{DynamicResource AppIdColor}" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>
    <TextBlock Text="Dependencies" Foreground="{DynamicResource AppFgColor}" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock Text="Check that each monitored app can be fault-identified on THIS machine (detects each app's .NET runtime and confirms the stack-walker can load it - no dump needed). Start the apps first for the most accurate result." Foreground="{DynamicResource AppIdColor}" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
      <Button x:Name="BtnMonVerify" Content="Verify deps (monitored apps)" Height="30" MinWidth="200"/>
    </StackPanel>
    <TextBlock x:Name="LblMonVerify" Foreground="{DynamicResource AppIdColor}" TextWrapping="Wrap" Margin="0,0,0,12"/>

    <Border BorderBrush="{DynamicResource AppIdColor}" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>
    <TextBlock Text="Configuration (live editor)" Foreground="{DynamicResource AppFgColor}" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <StackPanel x:Name="PnlMonConfig" Margin="0,0,0,8"/>
    <StackPanel Orientation="Horizontal">
      <Button x:Name="BtnMonSave"   Content="Save config" Height="28" MinWidth="110" Margin="0,0,8,0"/>
      <Button x:Name="BtnMonReload" Content="Reload"      Height="28" MinWidth="80"/>
    </StackPanel>

    <Border BorderBrush="{DynamicResource AppIdColor}" BorderThickness="0,1,0,0" Margin="0,12,0,10"/>
    <DockPanel Margin="0,0,0,4">
      <TextBlock DockPanel.Dock="Left" Text="Monitor log (live)" Foreground="{DynamicResource AppFgColor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <CheckBox x:Name="ChkMonTail" DockPanel.Dock="Right" Content="Live tail" IsChecked="True" Foreground="{DynamicResource AppFgColor}" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBox x:Name="TxtMonLog" Height="130" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
             Background="{DynamicResource CardBgColor}" Foreground="{DynamicResource AppFgColor}"/>
  </StackPanel>
</ScrollViewer>
